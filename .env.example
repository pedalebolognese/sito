# Copia questo file in ".env" e compila i valori.

# Dove stanno le foto dell'archivio (cartelle media_web/, thumbs/, media/)
#  - in sviluppo, con "npm run media":  http://localhost:4322
#  - online: il dominio pubblico del bucket Cloudflare R2
PUBLIC_MEDIA_BASE=http://localhost:4322

# Calendario uscite: Google Calendar > Impostazioni del calendario >
# "Indirizzo pubblico in formato iCal" (calendario pubblico) oppure "Indirizzo segreto"
GOOGLE_CALENDAR_ICS=

# Link "Aggiungi al tuo calendario" mostrato ai soci (facoltativo), es.
# https://calendar.google.com/calendar/u/0?cid=...
PUBLIC_CALENDAR_SUBSCRIBE=

# Archivio percorsi: Google Fogli > File > Condividi > Pubblica sul web > formato CSV
PERCORSI_CSV=

# Solo per la demo: indirizzo pubblico della demo e fascia "Anteprima" + noindex
# SITE_URL=https://pedalebolognese-anteprima.fcicognani.workers.dev
# PUBLIC_DEMO=1
