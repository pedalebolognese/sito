---
// La prossima uscita in evidenza, in cima al calendario.
import type { Evento } from '../lib/google';
import { ora } from '../lib/format';
import { linkGoogleCalendar } from '../lib/ics';

interface Props { e: Evento }
const { e } = Astro.props;
const base = Astro.site?.href.replace(/\/$/, '') ?? '';
const quando = new Intl.DateTimeFormat('it-IT', { weekday: 'long', day: 'numeric', month: 'long', timeZone: 'Europe/Rome' }).format(e.start);
const maps = e.location ? `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(e.location)}` : null;
const giorni = Math.round((e.start.getTime() - Date.now()) / 864e5);
const traQuanto = giorni <= 0 ? 'oggi' : giorni === 1 ? 'domani' : giorni < 14 ? `tra ${giorni} giorni` : null;
---
<section class="prossima" aria-labelledby="prossima-titolo">
  <p class="prossima__occhiello">La prossima uscita{traQuanto && <> · <strong>{traQuanto}</strong></>}</p>
  <h2 id="prossima-titolo">{e.href ? <a href={e.href}>{e.title}</a> : e.title}</h2>
  <p class="prossima__quando">
    <span class="maiuscola">{quando}</span>
    {!e.allDay && <> · ritrovo ore <strong>{ora(e.start)}</strong></>}
  </p>
  {maps && <p>📍 <a href={maps} target="_blank" rel="noopener">{e.location}</a></p>}
  {e.dettagli && e.dettagli.length > 0 && <p class="prossima__percorso">🚴 {e.dettagli.join(' — ')}</p>}
  <p class="prossima__azioni">
    {e.href && <a class="btn" href={e.href}>Percorso e mappa</a>}
    {e.id && <a class="btn btn--bordo" href={`/uscite/${e.id}.ics`}>Aggiungi al calendario</a>}
    <a class="btn btn--bordo" href={linkGoogleCalendar(e, base)} target="_blank" rel="noopener">Google Calendar</a>
  </p>
</section>

<style>
  .prossima {
    background: var(--blu); color: var(--bianco); border-radius: var(--raggio); box-shadow: var(--ombra);
    padding: 1.4rem 1.5rem 1.5rem; margin: 0 0 2rem; border-top: 5px solid var(--rosso);
  }
  .prossima__occhiello { margin: 0 0 0.3rem; font-size: 0.85rem; text-transform: uppercase; letter-spacing: 0.06em; opacity: 0.85; }
  .prossima h2 { margin: 0 0 0.4rem; font-size: clamp(1.8rem, 4vw, 2.4rem); color: var(--bianco); }
  .prossima h2 a { color: inherit; text-decoration: none; }
  .prossima h2 a:hover { text-decoration: underline; }
  .prossima p { margin: 0.25rem 0; }
  .prossima a:not(.btn) { color: var(--bianco); }
  .prossima__quando { font-size: 1.1rem; }
  .maiuscola { display: inline-block; }
  .maiuscola::first-letter { text-transform: uppercase; }
  .prossima__azioni { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-top: 1rem !important; }
  .prossima .btn { background: var(--rosso); border-color: var(--rosso); }
  .prossima .btn--bordo { background: transparent; color: var(--bianco); border-color: rgb(255 255 255 / 70%); }
  .prossima .btn--bordo:hover { background: rgb(255 255 255 / 12%); color: var(--bianco); }
</style>
