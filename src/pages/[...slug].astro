---
// Pagine fisse (src/content/pagine): /societa/, /regolamento/, ...
import { getCollection, render } from 'astro:content';
import Base from '../layouts/Base.astro';

export async function getStaticPaths() {
  const pagine = await getCollection('pagine');
  return pagine.map((p) => ({ params: { slug: p.id }, props: { p } }));
}
const { p } = Astro.props;
const { Content } = await render(p);
---
<Base title={p.data.title} description={p.data.descrizione}>
  <div class="stretto intestazione-pagina">
    <h1>{p.data.title}</h1>
  </div>
  <article class="stretto prosa">
    <Content />
  </article>
</Base>
