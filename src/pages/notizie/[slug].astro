---
import { getCollection, getEntry, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import SchedaGalleria from '../../components/SchedaGalleria.astro';
import { data, pubblicato } from '../../lib/format';
import { full } from '../../lib/media';

export async function getStaticPaths() {
  const notizie = await getCollection('notizie', pubblicato);
  return notizie.map((n) => ({ params: { slug: n.id }, props: { n } }));
}
const { n } = Astro.props;
const { Content } = await render(n);
const galleria = n.data.galleria ? await getEntry('gallerie', n.data.galleria) : undefined;
---
<Base title={n.data.title} description={n.data.sommario} image={n.data.cover}>
  <div class="stretto intestazione-pagina">
    <p class="briciole"><a href="/notizie/">Notizie</a> · {data(n.data.date)}</p>
    <h1>{n.data.title}</h1>
  </div>
  <article class="stretto prosa">
    {n.data.cover && <img src={full(n.data.cover)} alt="" />}
    <Content />
  </article>
  {galleria && (
    <div class="stretto" style="margin-top:2rem">
      <h2>Le foto</h2>
      <div class="griglia"><SchedaGalleria g={galleria} /></div>
    </div>
  )}
</Base>
